@{
    ViewData["Title"] = "Mi Panel";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="mb-0">Bienvenido, @ViewBag.NombreUsuario</h2>
        <small class="text-muted">Universidad Privada del Valle &mdash; Sede Sucre</small>
    </div>
    <span class="badge bg-secondary fs-6">Usuario</span>
</div>

<!-- Tarjetas de resumen -->
<div class="row g-4 mb-4">
    <!-- Catálogo -->
    <div class="col-md-4">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="rounded-circle bg-primary bg-opacity-10 p-3">
                    <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" fill="#0d6efd" class="bi bi-book" viewBox="0 0 16 16">
                        <path d="M1 2.828c.885-.37 2.154-.769 3.388-.893 1.33-.134 2.458.063 3.112.752v9.746c-.935-.53-2.12-.603-3.213-.493-1.18.12-2.37.461-3.287.811zm7.5-.141c.654-.689 1.782-.886 3.112-.752 1.234.124 2.503.523 3.388.893v9.923c-.918-.35-2.107-.692-3.287-.81-1.094-.111-2.278-.039-3.213.492zM8 1.783C7.015.936 5.587.81 4.287.94c-1.514.153-3.042.672-3.994 1.105A.5.5 0 0 0 0 2.5v11a.5.5 0 0 0 .707.455c.882-.4 2.303-.881 3.68-1.02 1.409-.142 2.59.087 3.223.877a.5.5 0 0 0 .78 0c.633-.79 1.814-1.019 3.222-.877 1.378.139 2.8.62 3.681 1.02A.5.5 0 0 0 16 13.5v-11a.5.5 0 0 0-.293-.455c-.952-.433-2.48-.952-3.994-1.105C10.413.809 8.985.936 8 1.783"/>
                    </svg>
                </div>
                <div>
                    <div class="text-muted small">Libros Disponibles</div>
                    <div class="fs-3 fw-bold text-primary">@ViewBag.LibrosDisponibles</div>
                    <div class="text-muted small">en catálogo</div>
                </div>
            </div>
            <div class="card-footer bg-transparent border-0">
                <a asp-controller="Libros" asp-action="Index" class="btn btn-sm btn-outline-primary w-100">Ver Catálogo</a>
            </div>
        </div>
    </div>

    <!-- Mis préstamos totales -->
    <div class="col-md-4">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="rounded-circle bg-info bg-opacity-10 p-3">
                    <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" fill="#0dcaf0" class="bi bi-journal-bookmark" viewBox="0 0 16 16">
                        <path fill-rule="evenodd" d="M6 8V1h1v6.117L8.743 6.07a.5.5 0 0 1 .514 0L11 7.117V1h1v7a.5.5 0 0 1-.757.429L9 7.083 6.757 8.43A.5.5 0 0 1 6 8"/>
                        <path d="M3 0h10a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2v-1h1v1a1 1 0 0 0 1 1h10a1 1 0 0 0 1-1V2a1 1 0 0 0-1-1H3a1 1 0 0 0-1 1v1H1V2a2 2 0 0 1 2-2"/>
                        <path d="M1 5v-.5a.5.5 0 0 1 1 0V5h.5a.5.5 0 0 1 0 1h-2a.5.5 0 0 1 0-1zm0 3v-.5a.5.5 0 0 1 1 0V8h.5a.5.5 0 0 1 0 1h-2a.5.5 0 0 1 0-1zm0 3v-.5a.5.5 0 0 1 1 0v.5h.5a.5.5 0 0 1 0 1h-2a.5.5 0 0 1 0-1z"/>
                    </svg>
                </div>
                <div>
                    <div class="text-muted small">Mis Préstamos</div>
                    <div class="fs-3 fw-bold text-info">@ViewBag.MisPrestamos</div>
                    <div class="text-muted small">en total</div>
                </div>
            </div>
            <div class="card-footer bg-transparent border-0">
                <a asp-controller="Prestamos" asp-action="Index" class="btn btn-sm btn-outline-info w-100">Ver mis préstamos</a>
            </div>
        </div>
    </div>

    <!-- Préstamos activos -->
    <div class="col-md-4">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="rounded-circle bg-success bg-opacity-10 p-3">
                    <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" fill="#198754" class="bi bi-check2-circle" viewBox="0 0 16 16">
                        <path d="M2.5 8a5.5 5.5 0 0 1 8.25-4.764.5.5 0 0 0 .5-.866A6.5 6.5 0 1 0 14.5 8a.5.5 0 0 0-1 0 5.5 5.5 0 1 1-11 0"/>
                        <path d="M15.354 3.354a.5.5 0 0 0-.708-.708L8 9.293 5.354 6.646a.5.5 0 1 0-.708.708l3 3a.5.5 0 0 0 .708 0z"/>
                    </svg>
                </div>
                <div>
                    <div class="text-muted small">Préstamos Activos</div>
                    <div class="fs-3 fw-bold text-success">@ViewBag.MisPrestamosActivos</div>
                    <div class="text-muted small">sin devolver</div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Mensaje informativo -->
<div class="alert alert-info border-0 shadow-sm" role="alert">
    <strong>¿Necesitas un libro?</strong> Visita el catálogo y solicita un préstamo con el bibliotecario.
</div>
