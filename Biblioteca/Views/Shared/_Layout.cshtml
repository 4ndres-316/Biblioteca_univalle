<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Biblioteca Univalle Sucre</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Biblioteca.styles.css" asp-append-version="true" />
    <style>
        :root {
            --guindo:      #7B1034;
            --guindo-dark: #5a0b24;
            --gris:        #6c757d;
            --gris-claro:  #f4f4f4;
            --gris-borde:  #dee2e6;
        }

        body { background-color: var(--gris-claro); }

        /* Navbar */
        .navbar-guindo { background-color: var(--guindo) !important; }

        /* Sidebar */
        .sidebar {
            min-height: calc(100vh - 56px);
            background: #fff;
            border-right: 1px solid var(--gris-borde);
            padding-top: 1rem;
        }
        .sidebar .nav-link {
            color: #495057;
            border-radius: 0.375rem;
            margin-bottom: 2px;
        }
        .sidebar .nav-link:hover {
            background-color: #f0e6ea;
            color: var(--guindo);
        }
        .sidebar .nav-link.active {
            background-color: var(--guindo);
            color: #fff;
        }
        .sidebar .nav-section {
            font-size: .68rem;
            text-transform: uppercase;
            letter-spacing: .08em;
            color: var(--gris);
            padding: .5rem .75rem .25rem;
        }

        /* Contenido */
        .main-content { padding: 1.5rem; }

        /* Botones guindo */
        .btn-guindo {
            background-color: var(--guindo);
            border-color: var(--guindo);
            color: #fff;
        }
        .btn-guindo:hover {
            background-color: var(--guindo-dark);
            border-color: var(--guindo-dark);
            color: #fff;
        }
        .btn-outline-guindo {
            color: var(--guindo);
            border-color: var(--guindo);
        }
        .btn-outline-guindo:hover {
            background-color: var(--guindo);
            color: #fff;
        }
    </style>
</head>
<body>
    <!-- Navbar superior -->
    <nav class="navbar navbar-expand-sm navbar-guindo shadow-sm">
        <div class="container-fluid">
            <a class="navbar-brand d-flex align-items-center gap-2 text-white fw-bold"
               asp-controller="Home" asp-action="Index">
                <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" fill="white"
                     class="bi bi-book-half" viewBox="0 0 16 16">
                    <path d="M8.5 2.687c.654-.689 1.782-.886 3.112-.752 1.234.124 2.503.523 3.388.893v9.923c-.918-.35-2.107-.692-3.287-.81-1.094-.111-2.278-.039-3.213.492zM8 1.783C7.015.936 5.587.81 4.287.94c-1.514.153-3.042.672-3.994 1.105A.5.5 0 0 0 0 2.5v11a.5.5 0 0 0 .707.455c.882-.4 2.303-.881 3.68-1.02 1.409-.142 2.59.087 3.223.877a.5.5 0 0 0 .78 0c.633-.79 1.814-1.019 3.222-.877 1.378.139 2.8.62 3.681 1.02A.5.5 0 0 0 16 13.5v-11a.5.5 0 0 0-.293-.455c-.952-.433-2.48-.952-3.994-1.105C10.413.809 8.985.936 8 1.783"/>
                </svg>
                Biblioteca
                <small class="text-white-50 d-none d-md-inline fw-normal" style="font-size:.72rem;">
                    Univalle Sucre
                </small>
            </a>

            <div class="ms-auto d-flex align-items-center gap-3">
                @if (User.Identity != null && User.Identity.IsAuthenticated)
                {
                    @if (User.IsInRole("Administrador"))
                    {
                        <span class="badge bg-white text-danger">Administrador</span>
                    }
                    else if (User.IsInRole("Bibliotecario"))
                    {
                        <span class="badge bg-white" style="color:var(--guindo)">Bibliotecario</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">Usuario</span>
                    }

                    <span class="text-white-50 small d-none d-md-inline">@User.Identity.Name</span>

                    <form asp-controller="Account" asp-action="Logout" method="post" class="mb-0">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-sm btn-outline-light">Cerrar sesión</button>
                    </form>
                }
                else
                {
                    <a asp-controller="Account" asp-action="Login"
                       class="btn btn-sm btn-outline-light">Iniciar sesión</a>
                }
            </div>
        </div>
    </nav>

    <div class="container-fluid">
        <div class="row">

            @if (User.Identity != null && User.Identity.IsAuthenticated)
            {
                <nav class="col-md-2 d-none d-md-block sidebar">

                    <div class="nav-section">Principal</div>
                    <ul class="nav flex-column px-2 mb-2">
                        <li class="nav-item">
                            <a class="nav-link @(ViewData["Title"]?.ToString()?.Contains("Dashboard") == true ? "active" : "")"
                               asp-controller="Home" asp-action="Index">
                                Dashboard
                            </a>
                        </li>
                    </ul>

                    @if (User.IsInRole("Administrador") || User.IsInRole("Bibliotecario"))
                    {
                        <div class="nav-section">Gestión</div>
                        <ul class="nav flex-column px-2 mb-2">
                            <li class="nav-item">
                                <a class="nav-link @(ViewData["Title"]?.ToString()?.Contains("Libro") == true ? "active" : "")"
                                   asp-controller="Libros" asp-action="Index">
                                    Libros
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @(ViewData["Title"]?.ToString()?.Contains("Préstamo") == true || ViewData["Title"]?.ToString()?.Contains("Prestamo") == true ? "active" : "")"
                                   asp-controller="Prestamos" asp-action="Index">
                                    Préstamos
                                </a>
                            </li>
                        </ul>
                    }

                    @if (User.IsInRole("Administrador"))
                    {
                        <div class="nav-section">Administración</div>
                        <ul class="nav flex-column px-2 mb-2">
                            <li class="nav-item">
                                <a class="nav-link @(ViewData["Title"]?.ToString()?.Contains("Usuario") == true ? "active" : "")"
                                   asp-controller="Usuarios" asp-action="Index">
                                    Usuarios
                                </a>
                            </li>
                        </ul>
                    }

                    @if (User.IsInRole("Usuario"))
                    {
                        <div class="nav-section">Mi Biblioteca</div>
                        <ul class="nav flex-column px-2 mb-2">
                            <li class="nav-item">
                                <a class="nav-link @(ViewData["Title"]?.ToString()?.Contains("Libro") == true ? "active" : "")"
                                   asp-controller="Libros" asp-action="Index">
                                    Catálogo
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @(ViewData["Title"]?.ToString()?.Contains("Préstamo") == true || ViewData["Title"]?.ToString()?.Contains("Prestamo") == true ? "active" : "")"
                                   asp-controller="Prestamos" asp-action="Index">
                                    Mis Préstamos
                                </a>
                            </li>
                        </ul>
                    }

                </nav>

                <main class="col-md-10 main-content">
                    @RenderBody()
                </main>
            }
            else
            {
                <main class="col-12 main-content">
                    @RenderBody()
                </main>
            }

        </div>
    </div>

    <footer class="border-top footer text-muted py-2 mt-3" style="background:#fff;">
        <div class="container-fluid px-3">
            <small>&copy; 2026 - Biblioteca Univalle Sede Sucre</small>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
