@model Biblioteca.Models.Prestamos

@{
    ViewData["Title"] = "Detalle del Préstamo";
}

<h1>Detalle del Préstamo</h1>

<div>
    <h4>Préstamos</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">Usuario</dt>
        <dd class="col-sm-10">@(Model.usuario?.nombre ?? "—")</dd>

        <dt class="col-sm-2">Libro</dt>
        <dd class="col-sm-10">@(Model.libro?.nombre ?? "—")</dd>

        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.fechaPrestamo)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.fechaPrestamo)</dd>

        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.fechaDevolucion)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.fechaDevolucion)</dd>

        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.estado)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.estado)</dd>
    </dl>
</div>

<div>
    @if (User.IsInRole("Administrador") || User.IsInRole("Bibliotecario"))
    {
        <a asp-action="Edit" asp-route-id="@Model?.id">Edit</a> @:|
    }
    <a asp-action="Index">Volver al listado</a>
</div>
