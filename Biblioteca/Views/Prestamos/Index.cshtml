@model IEnumerable<Biblioteca.Models.Prestamos>

@{
    ViewData["Title"] = "Préstamos";
}

<h1>Préstamos</h1>

@if (User.IsInRole("Administrador") || User.IsInRole("Bibliotecario"))
{
    <p>
        <a asp-action="Create">Nuevo Préstamo</a>
    </p>
}

<table class="table">
    <thead>
        <tr>
            <th>Usuario</th>
            <th>Libro</th>
            <th>@Html.DisplayNameFor(model => model.fechaPrestamo)</th>
            <th>@Html.DisplayNameFor(model => model.fechaDevolucion)</th>
            <th>@Html.DisplayNameFor(model => model.estado)</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@(item.usuario?.nombre ?? "—")</td>
                <td>@(item.libro?.nombre ?? "—")</td>
                <td>@Html.DisplayFor(modelItem => item.fechaPrestamo)</td>
                <td>@Html.DisplayFor(modelItem => item.fechaDevolucion)</td>
                <td>@Html.DisplayFor(modelItem => item.estado)</td>
                <td>
                    @if (User.IsInRole("Administrador") || User.IsInRole("Bibliotecario"))
                    {
                        <a asp-action="Edit" asp-route-id="@item.id">Edit</a>
                        <text> | </text>
                        <a asp-action="Details" asp-route-id="@item.id">Details</a>
                        <text> | </text>
                        <a asp-action="Delete" asp-route-id="@item.id">Delete</a>
                    }
                    else
                    {
                        <a asp-action="Details" asp-route-id="@item.id">Details</a>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>
